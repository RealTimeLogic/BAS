<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{81E7B3A4-546F-C133-39D8-3D34E32C1A1C}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>mako</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">$(DefaultPlatformToolset)</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <BasRoot>$(ProjectDir)..\..\..\</BasRoot>
    <SharkSslNativeDefines Condition="'$(SharkSslAsm)'!='off' And '$(SHARKSSL_PSA_CONSUMER)'!='1'">SHARKSSL_OPTIMIZED_AES_ASM=1;SHARKSSL_OPTIMIZED_SHA256_ASM=1;</SharkSslNativeDefines>
    <!-- SQLite is optional in the public source distribution. -->
    <UseSqlite Condition="'$(UseSqlite)' == '' and Exists('$(BasRoot)src\sqlite3.c') and Exists('$(BasRoot)src\sqlite3.h')">true</UseSqlite>
    <UseSqlite Condition="'$(UseSqlite)' == ''">false</UseSqlite>
    <MakoZip Condition="'$(MakoZip)' == ''">$(BasRoot)mako.zip</MakoZip>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\obj\VcMake\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(OutDir)intermediate\</IntDir>
    <TargetName>mako</TargetName>
    <LinkIncremental>false</LinkIncremental>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <MakoSqlDefine Condition="'$(UseSqlite)' == 'true'">MAKO_SQL_BACKEND=MAKO_SQL_SQLITE</MakoSqlDefine>
    <MakoSqlDefine Condition="'$(UseSqlite)' != 'true'">MAKO_SQL_BACKEND=MAKO_SQL_NONE</MakoSqlDefine>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(BasRoot)inc;$(BasRoot)inc\arch\Windows;$(BasRoot)inc\arch\NET\Windows;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>BA_ENABLE_MDNS=1;BA_ENABLE_MDNS_LUA=1;BA_FILE_OFFSET_BITS=64;MAKO_ENABLE_EMBEDDED_ZIP_FALLBACK=0;BA_BYTE_ORDER=BA_BYTE_ORDER_LITTLE_ENDIAN;BA_ENABLE_LUA_DEBUGGER=1;MAKO;MAKO_ENABLE_LUA_MODULE_INTERFACE=1;$(MakoSqlDefine);_CRT_SECURE_NO_WARNINGS;WIN32_LEAN_AND_MEAN=1;WIN32;_CONSOLE;$(SharkSslNativeDefines)SHARKSSL_OPTIMIZED_CHACHA_ASM=0;SHARKSSL_OPTIMIZED_POLY1305_ASM=0;SHARKSSL_OPTIMIZED_GHASH_ASM=0;SHARKSSL_OPTIMIZED_GCM_ASM=0;SHARKSSL_OPTIMIZED_GCM_VAES_ASM=0;SHARKSSL_X25519_ASM=0;SHARKSSL_X25519_ASM_HOOK=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)$(ProjectName).pdb</ProgramDataBaseFileName>
    </ClCompile>
    <Link>
      <AdditionalDependencies>ws2_32.lib;advapi32.lib;user32.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ProgramDatabaseFile>$(OutDir)$(TargetName).pdb</ProgramDatabaseFile>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <StringPooling>true</StringPooling>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'Win32'">
    <ClCompile>
      <PreprocessorDefinitions>SHARKSSL_OPTIMIZED_SHA384_ASM=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <MASM>
      <UseSafeExceptionHandlers>true</UseSafeExceptionHandlers>
    </MASM>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64' And '$(SharkSslAsm)'!='off' And '$(SHARKSSL_PSA_CONSUMER)'!='1'">
    <ClCompile>
      <PreprocessorDefinitions>SHARKSSL_ECC_P256_ASM=1;SHARKSSL_ECC_P384_ASM=1;SHARKSSL_OPTIMIZED_BIGINT_ASM=1;SHARKSSL_OPTIMIZED_SHA384_ASM=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(Platform)' == 'Win32' And '$(SharkSslAsm)'!='off' And '$(SHARKSSL_PSA_CONSUMER)'!='1'">
    <MASM Include="..\..\..\src\crypto\X86_MSVC\SharkSslAes_X86.asm" />
    <MASM Include="..\..\..\src\crypto\X86_MSVC\SharkSslSha256_X86.asm" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'x64' And '$(SharkSslAsm)'!='off' And '$(SHARKSSL_PSA_CONSUMER)'!='1'">
    <MASM Include="..\..\..\src\crypto\X64_MSVC\SharkSslAes_X64.asm" />
    <MASM Include="..\..\..\src\crypto\X64_MSVC\SharkSslSha256_X64.asm" />
    <MASM Include="..\..\..\src\crypto\X64_MSVC\SharkSslSha512_X64.asm" />
    <MASM Include="..\..\..\src\crypto\X64_MSVC\SharkSslP256_X64.asm" />
    <MASM Include="..\..\..\src\crypto\X64_MSVC\SharkSslP384_X64.asm" />
    <MASM Include="..\..\..\src\crypto\X64_MSVC\SharkSslBigInt_X64.asm" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="..\..\..\src\BAS.c" />
    <ClCompile Include="..\..\..\src\arch\NET\generic\SoDisp.c" />
    <ClCompile Include="..\..\..\src\arch\NET\BamDNS-Sock.c" />
    <ClCompile Include="..\..\..\src\arch\Windows\ThreadLib.c" />
    <ClCompile Include="..\..\..\src\DiskIo\windows\BaFile.c" />
    <ClCompile Include="..\src\MakoMain.c" />
    <ClCompile Include="..\src\Windows\MakoWinMain.c" />
    <ClCompile Include="..\src\Windows\servutil.c" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseSqlite)' == 'true'">
    <ClCompile Include="..\..\..\src\ls_sqlite3.c" />
    <ClCompile Include="..\..\..\src\luasql.c" />
    <ClCompile Include="..\..\..\src\sqlite3.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
  <Target Name="ValidateMakoOptions" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UseSqlite)' != 'true' and '$(UseSqlite)' != 'false'" Text="UseSqlite must be true or false." />
    <Error Condition="'$(UseSqlite)' == 'true' and (!Exists('$(BasRoot)src\sqlite3.c') or !Exists('$(BasRoot)src\sqlite3.h'))" Text="UseSqlite=true requires src\sqlite3.c and src\sqlite3.h. Add the SQLite amalgamation or set UseSqlite=false." />
  </Target>
  <Target Name="CopyMakoResources" AfterTargets="Build" Condition="Exists('$(MakoZip)')">
    <Copy SourceFiles="$(MakoZip)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
